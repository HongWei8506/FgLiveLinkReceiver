{
	"FileVersion": 3,
	"Version": 2,
	"VersionName": "2.0",
	"FriendlyName": "FgLiveLinkReceiver",
	"Description": "FACEGOOD LiveLink Source for receiving JSON over sockets",
	"Category": "FACEGOOD",
	"CreatedBy": "FACEGOOD, Inc.",
	"CreatedByURL": "https://www.facegood.ca",
	"DocsURL": "https://github.com/FACEGOOD/FgLiveLinkReceiver",
	"MarketplaceURL": "",
	"SupportURL": "https://www.facegood.ca",
	"EngineVersion": "5.8.0",
	"CanContainContent": true,
	"Installed": true,
	"SupportedPrograms": [
		"LiveLinkHub"
	],
	"Modules": [
		{
			"Name": "FgLiveLinkReceiver",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"ProgramAllowList": [
				"LiveLinkHub"
			],
			"PlatformAllowList": [
				"Win64"
			]
		}
	],
	"Plugins": [
		{
			"Name": "LiveLink",
			"Enabled": true
		}
	]
}
